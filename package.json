{
	"name": "vscode-office",
	"displayName": "Office Viewer",
	"description": "View word, excel, powerpoint, pdf, epub, xmind and parquet files and using WYSIWYG editor for markdown.",
	"version": "4.2.0",
	"publisher": "cweijan",
	"icon": "image/logo.png",
	"engines": {
		"vscode": "^1.64.0"
	},
	"keywords": [
		"pdf",
		"word",
		"docx",
		"docm",
		"dotm",
		"excel",
		"xlsx",
		"xltx",
		"xltm",
		"xlt",
		"csv",
		"tsv",
		"ods",
		"ots",
		"powerpoint",
		"pptx",
		"ppsx",
		"potx",
		"ppsm",
		"potm",
		"markdown",
		"epub",
		"xmind",
		"parquet"
	],
	"categories": [
		"Visualization",
		"Other"
	],
	"bugs": {
		"url": "https://github.com/cweijan/vscode-office/issues",
		"email": "cweijan@163.com"
	},
	"homepage": "https://github.com/cweijan/vscode-office/blob/master/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/cweijan/vscode-office.git"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"browser": "./out/extension.web.js",
	"contributes": {
		"languages": [
			{
				"id": "csv",
				"aliases": [
					"CSV"
				],
				"extensions": [
					".csv"
				],
				"icon": {
					"light": "./resource/icons/csv_light.svg",
					"dark": "./resource/icons/csv.svg"
				}
			},
			{
				"id": "tsv",
				"aliases": [
					"TSV"
				],
				"extensions": [
					".tsv"
				],
				"icon": {
					"light": "./resource/icons/csv_light.svg",
					"dark": "./resource/icons/csv.svg"
				}
			},
			{
				"id": "spreadsheet",
				"aliases": [
					"Spreadsheet"
				],
				"extensions": [
					".xls",
					".xlt",
					".xlsx",
					".xlsm",
					".xltx",
					".xltm",
					".ods",
					".ots"
				],
				"icon": {
					"light": "./resource/icons/spreadsheet_light.svg",
					"dark": "./resource/icons/spreadsheet.svg"
				}
			},
			{
				"id": "document",
				"aliases": [
					"Document"
				],
				"extensions": [
					".docx",
					".docm",
					".dotx",
					".dotm"
				],
				"icon": {
					"light": "./resource/icons/document_light.svg",
					"dark": "./resource/icons/document.svg"
				}
			},
			{
				"id": "presentation",
				"aliases": [
					"Presentation"
				],
				"extensions": [
					".pptx",
					".pptm",
					".ppsx",
					".potx",
					".ppsm",
					".potm"
				],
				"icon": {
					"light": "./resource/icons/presentation_light.svg",
					"dark": "./resource/icons/presentation.svg"
				}
			},
			{
				"id": "parquet",
				"aliases": [
					"Parquet"
				],
				"extensions": [
					".parquet"
				],
				"icon": {
					"light": "./resource/icons/parquet_light.svg",
					"dark": "./resource/icons/parquet.svg"
				}
			},
			{
				"id": "epub",
				"aliases": [
					"EPUB"
				],
				"extensions": [
					".epub"
				],
				"icon": {
					"light": "./resource/icons/epub_light.svg",
					"dark": "./resource/icons/epub.svg"
				}
			},
			{
				"id": "xmind",
				"aliases": [
					"XMind"
				],
				"extensions": [
					".xmind"
				],
				"icon": {
					"light": "./resource/icons/mindmap_light.svg",
					"dark": "./resource/icons/mindmap.svg"
				}
			},
			{
				"id": "pdf",
				"aliases": [
					"PDF"
				],
				"extensions": [
					".pdf"
				],
				"icon": {
					"light": "./resource/icons/pdf_light.svg",
					"dark": "./resource/icons/pdf.svg"
				}
			},
			{
				"id": "markdown",
				"extensions": [
					".md",
					".markdown"
				],
				"icon": {
					"light": "./resource/icons/markdown_light.svg",
					"dark": "./resource/icons/markdown.svg"
				}
			}
		],
		"commands": [
			{
				"command": "office.markdown.switch",
				"title": "Switch markdown editor",
				"icon": "$(edit)"
			},
			{
				"command": "office.csv.switch",
				"title": "Switch CSV editor",
				"icon": "$(edit)"
			},
			{
				"command": "office.markdown.paste",
				"title": "Enhance paste in markdown",
				"enablement": "!office.extensionHost.web"
			}
		],
		"keybindings": [
			{
				"command": "office.markdown.paste",
				"key": "ctrl+v",
				"mac": "cmd+v",
				"when": "editorTextFocus && resourceLangId == markdown && !office.extensionHost.web"
			},
			{
				"command": "office.markdown.switch",
				"key": "ctrl+alt+e",
				"mac": "ctrl+cmd+e",
				"when": "editorTextFocus && editorLangId == markdown"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "office.markdown.switch",
					"when": "resourceExtname == '.md' || resourceExtname == '.markdown'",
					"group": "navigation@-2"
				},
				{
					"command": "office.csv.switch",
					"when": "resourceExtname == '.csv' || resourceExtname == '.tsv'",
					"group": "navigation@-2"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "cweijan.officeViewer",
				"displayName": "Office Viewer",
				"selector": [
					{
						"filenamePattern": "*.xls"
					},
					{
						"filenamePattern": "*.xlt"
					},
					{
						"filenamePattern": "*.xlsx"
					},
					{
						"filenamePattern": "*.xlsm"
					},
					{
						"filenamePattern": "*.xltx"
					},
					{
						"filenamePattern": "*.xltm"
					},
					{
						"filenamePattern": "file:/**/*.csv"
					},
					{
						"filenamePattern": "vscode-vfs:/**/*.csv"
					},
					{
						"filenamePattern": "vscode-remote:/**/*.csv"
					},
					{
						"filenamePattern": "*.tsv"
					},
					{
						"filenamePattern": "*.ods"
					},
					{
						"filenamePattern": "*.ots"
					},
					{
						"filenamePattern": "file:/**/*.docx"
					},
					{
						"filenamePattern": "vscode-vfs:/**/*.docx"
					},
					{
						"filenamePattern": "vscode-remote:/**/*.docx"
					},
					{
						"filenamePattern": "*.docm"
					},
					{
						"filenamePattern": "*.dotx"
					},
					{
						"filenamePattern": "*.dotm"
					},
					{
						"filenamePattern": "*.pptx"
					},
					{
						"filenamePattern": "*.pptm"
					},
					{
						"filenamePattern": "*.ppsx"
					},
					{
						"filenamePattern": "*.potx"
					},
					{
						"filenamePattern": "*.ppsm"
					},
					{
						"filenamePattern": "*.potm"
					},
					{
						"filenamePattern": "*.pdf"
					},
					{
						"filenamePattern": "*.epub"
					},
					{
						"filenamePattern": "*.xmind"
					}
				]
			},
			{
				"viewType": "cweijan.markdownViewer",
				"displayName": "Markdown Editor",
				"selector": [
					{
						"filenamePattern": "file:/**/*.md"
					},
					{
						"filenamePattern": "file:/**/*.markdown"
					},
					{
						"filenamePattern": "vscode-vfs:/**/*.md"
					},
					{
						"filenamePattern": "vscode-vfs:/**/*.markdown"
					},
					{
						"filenamePattern": "vscode-remote:/**/*.md"
					},
					{
						"filenamePattern": "vscode-remote:/**/*.markdown"
					}
				]
			},
			{
				"viewType": "cweijan.parquetViewer",
				"displayName": "Parquet Viewer",
				"selector": [
					{
						"filenamePattern": "*.parquet"
					}
				]
			}
		],
		"configuration": [
			{
				"title": "General",
				"order": 0,
				"properties": {
					"vscode-office.theme": {
						"type": "string",
						"enum": [
							"auto",
							"light",
							"dark"
						],
						"enumDescriptions": [
							"Light or dark, following the current VS Code theme.",
							"Always light.",
							"Always dark."
						],
						"default": "auto",
						"markdownDescription": "Theme of every viewer and editor of the extension. The EPUB pages follow `#vscode-office.epub.theme#` and the Markdown pages `#vscode-office.markdown.theme#`."
					}
				}
			},
			{
				"title": "Markdown",
				"order": 1,
				"properties": {
					"vscode-office.markdown.theme": {
						"type": "string",
						"enum": [
							"auto",
							"light",
							"dark"
						],
						"enumDescriptions": [
							"Follows `vscode-office.theme`.",
							"Light page.",
							"Dark page."
						],
						"default": "auto",
						"markdownDescription": "Colours of the Markdown editor's page (text, background, code blocks and diagrams); the toolbar, outline and menus follow `#vscode-office.theme#`."
					},
					"vscode-office.markdown.codeMirrorTheme": {
						"type": "string",
						"enum": [
							"auto",
							"light",
							"dark"
						],
						"default": "auto",
						"markdownDescription": "Theme of the code blocks in the Markdown editor. `auto` follows the page, so `#vscode-office.markdown.theme#`.",
						"markdownEnumDescriptions": [
							"Light or dark, following the page.",
							"The One Light colours.",
							"The One Dark colours."
						]
					},
					"vscode-office.markdown.mermaidTheme": {
						"type": "string",
						"enum": [
							"auto",
							"light",
							"light-forest",
							"light-ocean",
							"light-sunset",
							"dark",
							"dark-dracula"
						],
						"default": "auto",
						"markdownDescription": "Theme of the Mermaid diagrams in the Markdown editor. `auto` follows the page, so `#vscode-office.markdown.theme#`."
					},
					"vscode-office.markdown.editMode": {
						"type": "string",
						"enum": [
							"wysiwyg",
							"ir"
						],
						"default": "wysiwyg",
						"markdownDescription": "Default edit mode for the Markdown editor."
					},
					"vscode-office.markdown.restoreViewState": {
						"type": "boolean",
						"default": true,
						"markdownDescription": "Restore caret focus when opening a Markdown file. Scroll position is always restored."
					},
					"vscode-office.markdown.workspacePathAsImageBasePath": {
						"type": "boolean",
						"default": false,
						"description": "Using workspace path as markdown image base path."
					},
					"vscode-office.markdown.pasteImageToWorkspacePath": {
						"type": "boolean",
						"default": false,
						"description": "Paste markdown images into the workspace path and insert image links with a leading slash."
					},
					"vscode-office.markdown.pasterImgPath": {
						"type": "string",
						"default": "image/${fileName}/${now}.${ext}",
						"description": "Markdown paste image path, variables: workspaceDir, fileName, now, date (YYYYMMDD), uuid, ext (file extension)."
					},
					"vscode-office.markdown.uiFontSize": {
						"type": "number",
						"minimum": 10,
						"maximum": 24,
						"default": 13,
						"markdownDescription": "Font size of the Markdown editor's toolbar, menus and panels, in pixels."
					},
					"vscode-office.markdown.editorFontSize": {
						"type": "number",
						"minimum": 10,
						"maximum": 24,
						"default": 13,
						"markdownDescription": "Font size of the document text in the Markdown editor, in pixels. Ctrl/Cmd+wheel in the editor changes it."
					},
					"vscode-office.markdown.editorFontFamily": {
						"type": "string",
						"enum": [
							"default",
							"humanist",
							"serif",
							"old-style",
							"garamond",
							"charter",
							"slab-serif",
							"narrow",
							"mono",
							"jetbrains-mono",
							"courier"
						],
						"default": "default",
						"markdownDescription": "Font of the document text in the Markdown editor."
					},
					"vscode-office.markdown.boldColor": {
						"type": "string",
						"enum": [
							"default",
							"plain",
							"accent",
							"red",
							"orange",
							"purple",
							"teal"
						],
						"markdownEnumDescriptions": [
							"Slightly tinted.",
							"The text colour.",
							"The link colour.",
							"Red.",
							"Orange.",
							"Purple.",
							"Teal."
						],
						"default": "default",
						"markdownDescription": "Colour of bold text in the Markdown editor."
					},
					"vscode-office.markdown.pageWidth": {
						"type": "string",
						"enum": [
							"full",
							"a4",
							"a5",
							"b5",
							"letter",
							"768px",
							"960px"
						],
						"markdownEnumDescriptions": [
							"The full width of the editor.",
							"A4 paper, 210 mm.",
							"A5 paper, 148 mm.",
							"B5 paper, 176 mm.",
							"US Letter paper, 8.5 in.",
							"768 pixels.",
							"960 pixels."
						],
						"default": "full",
						"markdownDescription": "Maximum width of the document in the Markdown editor."
					},
					"vscode-office.markdown.editorLineHeight": {
						"type": "number",
						"minimum": 1,
						"maximum": 3,
						"default": 1.7,
						"markdownDescription": "Line spacing of the document text in the Markdown editor."
					},
					"vscode-office.markdown.codeFontFamily": {
						"type": "string",
						"enum": [
							"default",
							"cascadia-code",
							"consolas",
							"monaco",
							"andale-mono",
							"courier-new",
							"jetbrains-mono",
							"fira-code"
						],
						"default": "default",
						"markdownDescription": "Font of the code blocks in the Markdown editor. JetBrains Mono and Fira Code need to be installed."
					},
					"vscode-office.markdown.codeBlockMaxHeight": {
						"type": "string",
						"enum": [
							"none",
							"300px",
							"400px",
							"600px",
							"800px"
						],
						"default": "none",
						"markdownDescription": "Maximum height of a code block in the Markdown editor before it scrolls."
					},
					"vscode-office.markdown.imageMaxWidth": {
						"type": "number",
						"minimum": 10,
						"maximum": 100,
						"default": 100,
						"markdownDescription": "Maximum width of images in the Markdown editor, in % of the page width."
					},
					"vscode-office.markdown.imageMaxHeight": {
						"type": "number",
						"minimum": 10,
						"maximum": 100,
						"default": 70,
						"markdownDescription": "Maximum height of images in the Markdown editor, in % of the window height."
					}
				}
			},
			{
				"title": "Markdown PDF",
				"order": 2,
				"properties": {
					"vscode-office.markdown.chromiumPath": {
						"type": "string",
						"description": "Set the chromium browser location for exporting markdown pdf."
					},
					"vscode-office.markdown.puppeteerArgs": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [],
						"description": "Additional arguments to pass to Puppeteer/Chromium when exporting PDF. Example: [\"--no-sandbox\", \"--disable-setuid-sandbox\"] for Linux servers running as root."
					},
					"vscode-office.markdown.pdfMarginTop": {
						"type": "integer",
						"default": 25,
						"description": "Printed pdf default top margin."
					}
				}
			},
			{
				"title": "EPUB",
				"order": 3,
				"properties": {
					"vscode-office.epub.theme": {
						"type": "string",
						"enum": [
							"auto",
							"light",
							"dark"
						],
						"enumDescriptions": [
							"Follows `vscode-office.theme`.",
							"White pages, black text.",
							"Black pages, white text."
						],
						"default": "auto",
						"markdownDescription": "Colours of the EPUB reader's pages; the menus follow `#vscode-office.theme#`. The reader's \"Themes\" choice changes this setting in the user settings; a workspace value overrides it."
					}
				}
			}
		]
	},
	"scripts": {
		"dev": "vite --mode=development",
		"dev:web": "OFFICE_EXTENSION_TARGET=web vite --mode=development",
		"lint": "eslint \"src/**/*.{ts,tsx}\"",
		"lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
		"i18n:check": "node scripts/i18n-check.mjs",
		"build": "vite build --mode=production",
		"package": "vsce package --no-dependencies",
		"publish": "vsce publish --no-dependencies && ovsx publish --no-dependencies",
		"vscode:prepublish": "npm run build"
	},
	"devDependencies": {
		"@types/diff-match-patch": "1.0.32",
		"@types/node": "^26.1.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/vscode": "^1.64.0",
		"@typescript-eslint/eslint-plugin": "^8.62.1",
		"@typescript-eslint/parser": "^8.62.1",
		"@vitejs/plugin-react": "^6.0.2",
		"chokidar": "^5.0.0",
		"esbuild": "^0.28.1",
		"esbuild-plugin-copy": "2.1.1",
		"eslint": "^9.39.4",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.7.0",
		"less": "^4.2.0",
		"vite": "^8.0.16",
		"vite-plugin-static-copy": "^4.1.1"
	},
	"dependencies": {
		"@ant-design/icons": "^5.3.5",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/language": "^6.12.3",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.1",
		"@cweijan/exceljs": "^5.0.2",
		"@eigenpal/docx-editor-react": "^1.9.0",
		"@lezer/highlight": "^1.2.3",
		"@mind-elixir/import-xmind": "^1.0.8",
		"@vscode/codicons": "^0.0.45",
		"antd": "^5.15.4",
		"axios": "^1.18.1",
		"buffer": "^6.0.3",
		"chart.js": "^4.5.1",
		"chrome-finder": "^1.0.7",
		"codemirror": "^6.0.2",
		"codemirror-lang-latex": "^0.4.1",
		"codemirror-lang-mermaid": "^0.5.0",
		"diff-match-patch": "1.0.5",
		"epubjs": "^0.3.93",
		"file-type": "^19.6.0",
		"highlight.js": "^11.10.0",
		"hyparquet": "^1.26.1",
		"hyparquet-writer": "^0.15.7",
		"iconv-lite": "^0.6.3",
		"jszip": "^3.10.1",
		"katex": "^0.16.2",
		"markdown-it": "^14.1.0",
		"markdown-it-anchor": "^9.2.0",
		"markdown-it-checkbox": "^1.1.0",
		"markdown-it-front-matter": "^0.2.4",
		"markdown-it-mark": "^4.0.0",
		"markdown-it-obsidian-callouts": "^0.3.4",
		"markdown-it-plantuml": "^1.4.1",
		"markdown-it-toc-done-right": "^4.2.0",
		"mermaid": "^11.15.0",
		"mind-elixir": "^5.12.2",
		"mustache": "^4.0.1",
		"node-html-parser": "^7.0.1",
		"pdf-lib": "^1.11.2",
		"pptxviewjs": "^1.1.9",
		"prosemirror-commands": "^1.7.1",
		"prosemirror-dropcursor": "^1.8.2",
		"prosemirror-history": "^1.5.0",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.9",
		"prosemirror-state": "^1.4.4",
		"prosemirror-tables": "^1.8.5",
		"prosemirror-transform": "^1.12.0",
		"prosemirror-view": "^1.41.9",
		"puppeteer-core": "^25.1.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"save-svg-as-png": "^1.4.17",
		"udsv": "^0.5.3",
		"vscode-html-to-docx": "^1.1.3",
		"xlsx": "^0.18.5"
	}
}
